# ==============================================================================
# Location Ingestion Pipeline & Cache Configuration
# ==============================================================================

# Company Location API Key (Google Maps Platform API Key)
# Must have Geocoding API and Time Zone API enabled
LOCATION_API_KEY=your_google_maps_api_key_here

# API Base URL (Default: https://maps.googleapis.com/maps/api)
LOCATION_API_BASE_URL=https://maps.googleapis.com/maps/api

# Cache Freshness TTL in days (Default: 30 days to align with Google Maps ToS)
LOCATION_CACHE_TTL_DAYS=30

# Output directory for structured location JSON files
LOCATION_DATA_DIR=./data/locations

# Downloads/Temporary directory for bulk reference files
LOCATION_DOWNLOADS_DIR=./data/downloads

# Processing batch size
LOCATION_BATCH_SIZE=5000

# Concurrency level
LOCATION_CONCURRENCY=2

# Cron schedule for background cache refresh (Default: Sunday 03:00 UTC)
LOCATION_CRON_SCHEDULE=0 3 * * 0

# Comma-separated ISO 3166-1 alpha-2 country codes
LOCATION_COUNTRY_CODES=IN,US,GB,CA,AU,DE,FR,JP,BR,CN

# Feature classes to include (P=populated place, A=administrative area)
LOCATION_FEATURE_CLASSES=P,A

# Minimum population threshold (0 = no filter)
LOCATION_MIN_POPULATION=0
